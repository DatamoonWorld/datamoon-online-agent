NODE_ENV=production
PORT=3101
REGISTRATION_ENABLED=false
MAINTENANCE_MODE=false
SESSION_TTL_HOURS=12
PUBLIC_ORIGIN=https://datamoononline.com.br
DATAMOON_API_BASE_URL=http://127.0.0.1:3000
DATAMOON_API_TIMEOUT_MS=5000
DATAMOON_STORAGE_DIR=/var/lib/datamoon-web/storage
TRANSACTIONAL_EMAIL_ENABLED=false
DATAMOON_MAILER_SOCKET=/run/datamoon-mailer/mailer.sock
AWS_REGION=us-east-1
SES_FROM_EMAIL=no-reply@datamoononline.com.br
SES_FROM_NAME=Datamoons Online
