[Unit]
Description=Datamoons Online transactional mailer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=datamoon-mailer
Group=datamoon-web
WorkingDirectory=/opt/datamoon/datamoon-online-web
EnvironmentFile=/opt/datamoon/env/datamoon-web.env
ExecStart=/usr/bin/node /opt/datamoon/datamoon-online-web/src/mailer.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
UMask=0007
CapabilityBoundingSet=
AmbientCapabilities=
RuntimeDirectory=datamoon-mailer
RuntimeDirectoryMode=0750
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
